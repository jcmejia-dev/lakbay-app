# Server-only. Copy to .env.local; never commit filled values.
# Use the pooled PostgreSQL URL provided by Neon, including its TLS settings.
DATABASE_URL=
APP_BASE_URL=http://localhost:5173
# Keep the existing secret during migration. Otherwise generate a random secret.
AUTH_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for existing email signup/password recovery via Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Ridey server-only settings. Never use a NEXT_PUBLIC_ prefix.
# Leave empty to keep Ridey gracefully unavailable.
# Supported: openai-compatible or ollama
RIDEY_PROVIDER=
# OpenAI-compatible: https://your-provider.example/v1
# Ollama: https://your-secured-model.example (without /api/chat)
RIDEY_BASE_URL=
RIDEY_MODEL=
# Optional for authenticated endpoints; never paste this into browser code.
RIDEY_API_KEY=
