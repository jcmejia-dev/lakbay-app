{
  "name": "lakbay-motorcycle-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:ride-systems": "node --test tests/ride-systems.test.mjs",
    "dev": "next dev --port 5173",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-d1.mjs",
    "test": "npm run test:ride-systems && node --test tests/vercel-storage.test.mjs && npm run test:job3 && npm run test:notifications && node --test tests/launch.test.mjs",
    "db:import-avatars": "node --env-file-if-exists=.env.local scripts/import-avatars.mjs",
    "typecheck": "tsc --noEmit",
    "test:job3": "node --test tests/progression.test.mjs tests/ridey.test.mjs",
    "prebuild": "node scripts/generate-release.mjs",
    "predev": "node scripts/generate-release.mjs",
    "pretypecheck": "node scripts/generate-release.mjs",
    "test:notifications": "node scripts/generate-release.mjs && node --test tests/notifications.test.mjs",
    "pretest": "node scripts/generate-release.mjs",
    "push:keys": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
